{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.15"
  },
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "workspace-chrome"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "sumi-spaces"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "sumi-agents"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 69
          }
        }
      ],
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "tabs"
          },
          "size": {
            "px": 42
          },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "pane"
                    },
                    "reveal": "always",
                    "height": 30,
                    "position": "top"
                  },
                  "background": "background",
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "muted"
                  },
                  "radius": 2,
                  "gap": 8
                }
              }
            },
            {
              "id": "ink",
              "type": "block",
              "content": {
                "mod": "ink-painting",
                "props": {
                  "fold_for": "panel",
                  "fade_left": 230
                }
              },
              "size": {
                "px": 580
              },
              "min": 240,
              "max": 860
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true
            }
          ],
          "padding": [
            8,
            0
          ],
          "gap": 0
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "workspace-status"
          },
          "size": {
            "px": 28
          }
        }
      ],
      "resizable": false
    }
  ],
  "background": "canvas",
  "theme": "paper",
  "colors": {
    "background": "#efe7d6",
    "canvas": "#efe7d6",
    "surface": "#efe7d6",
    "chrome": "#efe7d6",
    "popover": "#f4eddd",
    "raised": "#f4eddd",
    "hover": "#e8dfcb",
    "selected": "#e3d9c3",
    "border": "#ddd3bd",
    "input": "#c9bda3",
    "foreground": "#1c1917",
    "muted": "#6b6457",
    "dim": "#948a78",
    "accent": "#b3301f",
    "accent_foreground": "#f4eddd",
    "solid": "#1c1917",
    "solid_foreground": "#efe7d6",
    "selection": "#d9cfb8",
    "working": "#1c1917",
    "blocked": "#b3301f",
    "done": "#b3301f",
    "idle": "#948a78",
    "unknown": "#b8ae99",
    "ansi0": "#1c1917",
    "ansi1": "#a8321f",
    "ansi2": "#55683a",
    "ansi3": "#8a6a1c",
    "ansi4": "#3d5670",
    "ansi5": "#6f4d68",
    "ansi6": "#3f6b64",
    "ansi7": "#b8ae99",
    "ansi8": "#6b6457",
    "ansi9": "#c0402b",
    "ansi10": "#6a7f49",
    "ansi11": "#a17c22",
    "ansi12": "#4f6c8c",
    "ansi13": "#86607e",
    "ansi14": "#4f8279",
    "ansi15": "#948a78",
    "cursor": "#b3301f"
  },
  "ui_font": "Hiragino Mincho ProN",
  "terminal_padding": [
    14,
    12
  ],
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "preview": "layouts/sumi.svg"
}
